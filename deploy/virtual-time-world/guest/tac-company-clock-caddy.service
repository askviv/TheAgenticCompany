[Unit]
Description=TheAgentCompany guest HTTPS front for accelerated company time
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
RuntimeDirectory=tac-https
RuntimeDirectoryMode=0750
StateDirectory=tac-company-clock-caddy
StateDirectoryMode=0750
EnvironmentFile=/etc/virtual-time-world/company-clock-caddy.env
Environment=XDG_DATA_HOME=/var/lib/tac-company-clock-caddy
Environment=XDG_CONFIG_HOME=/var/lib/tac-company-clock-caddy/.config
ExecStartPre=/usr/bin/caddy validate --config /etc/caddy/CompanyClockCaddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/caddy/CompanyClockCaddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/CompanyClockCaddyfile --adapter caddyfile --address unix//run/tac-https/admin.sock
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/caddy /etc/company-clock-tls
ReadWritePaths=/var/lib/tac-company-clock-caddy /run/tac-https
UMask=0027

[Install]
WantedBy=multi-user.target
