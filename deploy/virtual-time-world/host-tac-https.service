[Unit]
Description=Public HTTPS frontend for the fresh virtual company world
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
RuntimeDirectory=tac-https
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/caddy validate --config /etc/caddy/company-world/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/caddy/company-world/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/company-world/Caddyfile --adapter caddyfile --address unix//run/tac-https/admin.sock
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy /etc/caddy/company-world /run/tac-https
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
