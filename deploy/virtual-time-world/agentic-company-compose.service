[Unit]
Description=Company Compose projects after virtual clock synchronization
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=COMPOSE_CONFIG_DIR=/etc/company-workplace/compose
ExecStartPre=/usr/bin/python3 /usr/local/lib/virtual-time-world/prepare-healthcheck-cadence.py --config-dir ${COMPOSE_CONFIG_DIR}
ExecStart=/bin/sh -ec 'found=; for config in "$COMPOSE_CONFIG_DIR"/*.json; do [ -f "$config" ] || continue; found=1; docker compose --profile scheduler -f "$config" up -d --pull never --no-build --wait; done; [ -n "$found" ] || { echo "No fresh company Compose configurations found" >&2; exit 1; }'
ExecReload=/bin/sh -ec 'found=; for config in "$COMPOSE_CONFIG_DIR"/*.json; do [ -f "$config" ] || continue; found=1; docker compose --profile scheduler -f "$config" up -d --pull never --no-build --wait; done; [ -n "$found" ] || { echo "No fresh company Compose configurations found" >&2; exit 1; }'
ExecStop=/usr/local/lib/virtual-time-world/company-compose-stop
TimeoutStartSec=infinity
TimeoutStopSec=infinity
