+u64 timekeeping_max_cycles(u64 source_max_cycles, u32 mult, u32 shift)
+{
+	u64 max_cycles = source_max_cycles;
+
+	if (timekeeping_virtual_rate > 1) {
+		u64 max_nsec = (u64)NSEC_PER_SEC << shift;
+		u64 safe_cycles = div64_u64(U64_MAX - max_nsec, mult);
+
+		max_cycles = min(max_cycles, safe_cycles);
+	}
+	return max_cycles;
