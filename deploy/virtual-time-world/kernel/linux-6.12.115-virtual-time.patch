+static int __init virtual_time_setup(char *str)
+{
+	unsigned int rate;
+
+	if (kstrtouint(str, 0, &rate) || !rate ||
+	    rate > S64_MAX / ((u64)NTP_INTERVAL_LENGTH << NTP_SCALE_SHIFT))
+		panic("virtual_time: rate is outside the supported integer range");
+
+	timekeeping_virtual_rate = rate;
+	return 0;
+}
+early_param("virtual_time", virtual_time_setup);
 
