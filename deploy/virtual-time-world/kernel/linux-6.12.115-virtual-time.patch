+/* Return the NTP tick length in the timekeeper's scaled units. */
+static u64 timekeeping_scaled_ntp_tick_length(void)
+{
+	u64 tick;
+	u64 scaled_tick;
+
+	if (timekeeping_virtual_rate == 1)
+		return ntp_tick_length();
+	tick = ntp_tick_length();
+	if (check_mul_overflow(tick, (u64)timekeeping_virtual_rate,
+			       &scaled_tick))
+		panic("virtual_time: scaled NTP tick length overflow");
+	tick = scaled_tick;
+	if (tick > S64_MAX)
+		panic("virtual_time: scaled NTP tick length is too large");
+
+	return tick;
+}
