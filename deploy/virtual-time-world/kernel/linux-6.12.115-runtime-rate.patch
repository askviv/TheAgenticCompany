+static int timekeeping_virtual_rate_supported(struct clocksource *clock,
+					     unsigned int rate)
+{
+	u64 mult;
+	unsigned int shift_drop = 0;
+
+	if (!rate || rate > S64_MAX / ((u64)NTP_INTERVAL_LENGTH << NTP_SCALE_SHIFT))
+		return -ERANGE;
+
+	mult = (u64)clock->mult * rate;
+	while (mult >= U32_MAX) {
+		if (++shift_drop > clock->shift)
+			return -ERANGE;
+		mult = DIV_ROUND_CLOSEST_ULL((u64)clock->mult * rate,
+					      1ULL << shift_drop);
+	}
+	return 0;
+}
+
+ktime_t timekeeping_get_mono_with_rate(unsigned int *rate,
+				       unsigned int *clock_was_set_seq)
+{
+	struct timekeeper *tk = &tk_core.timekeeper;
+	unsigned int seq;
+	ktime_t base;
+	u64 nsecs;
+
+	do {
+		seq = read_seqcount_begin(&tk_core.seq);
+		base = tk->tkr_mono.base;
+		nsecs = timekeeping_get_ns(&tk->tkr_mono);
+		if (rate)
+			*rate = READ_ONCE(timekeeping_virtual_rate);
+		*clock_was_set_seq = tk->clock_was_set_seq;
+	} while (read_seqcount_retry(&tk_core.seq, seq));
+
+	return ktime_add_ns(base, nsecs);
+}
+
+struct timekeeping_rate_change {
+	unsigned int rate;
+	bool changed;
+};
+
+static int timekeeping_change_rate(void *data)
+{
+	struct timekeeping_rate_change *change = data;
+	struct timekeeper *tk = &tk_core.timekeeper;
+	struct clocksource *clock;
+	unsigned int old_cs_seq;
+	u64 cycle_last;
+	unsigned long flags;
+	int ret;
+
+	ret = tick_rate_change_supported();
+	if (ret)
+		return ret;
+
+	raw_spin_lock_irqsave(&timekeeper_lock, flags);
+	write_seqcount_begin(&tk_core.seq);
+	clock = tk->tkr_mono.clock;
+	ret = timekeeping_virtual_rate_supported(clock, change->rate);
+	if (ret)
+		goto out;
+
+	if (timekeeping_virtual_rate == change->rate)
+		goto out;
+
+	/* Account for elapsed cycles at the old rate before switching scales. */
+	timekeeping_forward_now(tk);
+	cycle_last = tk->tkr_mono.cycle_last;
+	old_cs_seq = tk->cs_was_changed_seq;
+	WRITE_ONCE(timekeeping_virtual_rate, change->rate);
+	tk_setup_internals(tk, clock);
+	/* Keep the old cycle pivot; the interval since it uses the new rate. */
+	tk->tkr_mono.cycle_last = cycle_last;
+	tk->tkr_raw.cycle_last = cycle_last;
+	/* The clocksource did not change; do not report a source replacement. */
+	tk->cs_was_changed_seq = old_cs_seq;
+	timekeeping_update(tk, TK_MIRROR | TK_CLOCK_WAS_SET);
+	change->changed = true;
+
+out:
+	write_seqcount_end(&tk_core.seq);
+	raw_spin_unlock_irqrestore(&timekeeper_lock, flags);
+	return ret;
+}
+
+static ssize_t virtual_time_rate_show(struct kobject *kobj,
+				      struct kobj_attribute *attr, char *buf)
+{
+	unsigned int seq, rate;
+
+	do {
+		seq = read_seqcount_begin(&tk_core.seq);
+		rate = READ_ONCE(timekeeping_virtual_rate);
+	} while (read_seqcount_retry(&tk_core.seq, seq));
+
+	return sysfs_emit(buf, "%u\n", rate);
+}
+
+static ssize_t virtual_time_rate_store(struct kobject *kobj,
+				       struct kobj_attribute *attr,
+				       const char *buf, size_t count)
+{
+	struct timekeeping_rate_change change = { };
+	int ret;
+
+	if (!capable(CAP_SYS_TIME))
+		return -EPERM;
+	ret = kstrtouint(buf, 0, &change.rate);
+	if (ret)
+		return ret;
+
+	mutex_lock(&timekeeping_virtual_rate_lock);
+	ret = stop_machine(timekeeping_change_rate, &change, NULL);
+	if (!ret) {
+		if (change.changed) {
+			clock_was_set(CLOCK_SET_WALL | CLOCK_SET_BOOT);
+			hrtimer_clock_rate_changed();
+			tick_clock_rate_changed();
+		}
+	}
+	mutex_unlock(&timekeeping_virtual_rate_lock);
+	return ret ? ret : count;
+}
+
+static struct kobj_attribute virtual_time_rate_attr =
+	__ATTR(virtual_time_rate, 0644, virtual_time_rate_show,
+	       virtual_time_rate_store);
+
+static int __init timekeeping_virtual_rate_sysfs_init(void)
+{
+	int ret = sysfs_create_file(kernel_kobj, &virtual_time_rate_attr.attr);
+
+	if (ret)
+		pr_err("virtual_time: failed to create rate control sysfs file: %d\n", ret);
+	return ret;
+}
+device_initcall(timekeeping_virtual_rate_sysfs_init);
 
