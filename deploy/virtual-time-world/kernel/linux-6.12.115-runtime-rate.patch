+static int tick_rate_change_check_cpu(int cpu)
+{
+	struct tick_device *td = &per_cpu(tick_cpu_device, cpu);
+	struct clock_event_device *dev = td->evtdev;
+
+	if (!dev)
+		return -EOPNOTSUPP;
+	if (td->mode != TICKDEV_MODE_ONESHOT)
+		return -EOPNOTSUPP;
+	if (!clockevent_state_oneshot(dev) &&
+	    !clockevent_state_oneshot_stopped(dev) &&
+	    !clockevent_state_shutdown(dev))
+		return -EOPNOTSUPP;
+	if ((dev->features & CLOCK_EVT_FEAT_KTIME) &&
+	    !(dev->features & CLOCK_EVT_FEAT_HRTIMER))
+		return -EOPNOTSUPP;
+	return 0;
+}
+
+int tick_rate_change_supported(void)
+{
+	int cpu, ret;
+
+	if (!IS_ENABLED(CONFIG_TICK_ONESHOT))
+		return -EOPNOTSUPP;
+	for_each_online_cpu(cpu) {
+		ret = tick_rate_change_check_cpu(cpu);
+		if (ret)
+			return ret;
+	}
+	return tick_broadcast_rate_change_supported();
+}
+
+static void tick_reprogram_rate_changed(void *unused)
+{
+	struct tick_device *td = this_cpu_ptr(&tick_cpu_device);
+	struct clock_event_device *dev = td->evtdev;
+
+	if (dev && dev->next_event != KTIME_MAX)
+		tick_program_event(dev->next_event, true);
+}
+
+void tick_clock_rate_changed(void)
+{
+	cpus_read_lock();
+	on_each_cpu(tick_reprogram_rate_changed, NULL, 1);
+	tick_broadcast_clock_rate_changed();
+	cpus_read_unlock();
+}
