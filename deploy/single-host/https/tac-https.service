[Unit]
Description=TheAgentCompany private LAN HTTPS
After=network-online.target
Wants=network-online.target

[Service]
User=caddy
Group=caddy
RuntimeDirectory=tac-https
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/caddy run --config /data/theagentcompany/source/deploy/single-host/https/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /data/theagentcompany/source/deploy/single-host/https/Caddyfile --adapter caddyfile --address unix//run/tac-https/admin.sock
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy /run/tac-https
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
