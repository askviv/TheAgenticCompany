# Copy outside the repository, chmod 600, and fill using your deployment settings.
SMTP4DEV_RELAY_HOST=mail.company.example.test
SMTP4DEV_RELAY_PORT=2587
SMTP4DEV_RELAY_LOGIN=viv_reply_relay@company.test
SMTP4DEV_RELAY_PASSWORD=
# Exclude your assistant address if it also belongs to the company domain.
SMTP4DEV_RELAY_EXPRESSION='recipient.toLowerCase() !== "assistant@assistant.test" && recipient.toLowerCase().endsWith("@company.test") ? recipient : null'

# Optional when using the SSH return path described in docs/LOCAL_EMAIL.md:
# SMTP4DEV_RELAY_PORT=19127
# SMTP4DEV_RELAY_GATEWAY_IP=<Docker's host.docker.internal IPv4 address>
