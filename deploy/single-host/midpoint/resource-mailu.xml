<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
          xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3"
          xmlns:mu="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/com.evolveum.polygon.scimrest.connector-mailu/com.evolveum.polygon.mailu.MailuConnector"
          xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
          oid="57a19684-cfe8-4f21-b7b4-0fb02b5ec002">
    <name>Mailu mailboxes</name>
    <description>Discovers and creates Mailu mailboxes, updates only the centrally managed display name, and never grants global administrator access or changes mailbox credentials or addresses.</description>
    <connectorRef type="c:ConnectorType">
        <filter>
            <q:text>connectorType = "com.evolveum.polygon.mailu.MailuConnector" and connectorVersion = "0.2.0-tac.1"</q:text>
        </filter>
    </connectorRef>
    <connectorConfiguration>
        <icfc:configurationProperties>
            <mu:baseAddress>https://mail.company.example.test/api/v1</mu:baseAddress>
            <mu:restTestEndpoint>/user</mu:restTestEndpoint>
            <mu:timeoutSeconds>20</mu:timeoutSeconds>
        </icfc:configurationProperties>
    </connectorConfiguration>
    <schemaHandling>
        <objectType>
            <kind>account</kind>
            <displayName>Mailu mailbox</displayName>
            <default>true</default>
            <delineation>
                <objectClass>ri:User</objectClass>
            </delineation>
            <attribute>
                <ref>ri:username</ref>
                <outbound>
                    <strength>weak</strength>
                    <source><path>$focus/emailAddress</path></source>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:displayed_name</ref>
                <outbound>
                    <strength>normal</strength>
                    <source><path>$focus/fullName</path></source>
                </outbound>
            </attribute>
            <attribute>
                <ref>ri:enabled</ref>
                <outbound><strength>weak</strength><expression><value>true</value></expression></outbound>
            </attribute>
            <attribute>
                <ref>ri:enable_imap</ref>
                <outbound><strength>weak</strength><expression><value>true</value></expression></outbound>
            </attribute>
            <attribute>
                <ref>ri:enable_pop</ref>
                <outbound><strength>weak</strength><expression><value>false</value></expression></outbound>
            </attribute>
            <attribute>
                <ref>ri:allow_spoofing</ref>
                <outbound><strength>weak</strength><expression><value>false</value></expression></outbound>
            </attribute>
            <credentials>
                <password>
                    <outbound>
                        <strength>weak</strength>
                        <source><path>$focus/credentials/password/value</path></source>
                        <condition><script><code>operation == 'add'</code></script></condition>
                    </outbound>
                </password>
            </credentials>
        </objectType>
    </schemaHandling>
    <capabilities xmlns:cap="http://midpoint.evolveum.com/xml/ns/public/resource/capabilities-3">
        <configured>
            <cap:liveSync><cap:enabled>false</cap:enabled></cap:liveSync>
            <cap:update><cap:enabled>true</cap:enabled></cap:update>
            <cap:delete><cap:enabled>false</cap:enabled></cap:delete>
            <cap:script><cap:enabled>false</cap:enabled></cap:script>
        </configured>
    </capabilities>
</resource>
