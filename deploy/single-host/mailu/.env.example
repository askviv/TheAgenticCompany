# Mailu configuration example for the private TheAgentCompany mail service.
# Copy to .env, then replace both secret values before deployment.
SECRET_KEY=REPLACE_WITH_RANDOM_16_BYTE_SECRET
SUBNET=172.22.0.0/24

# Employee addresses remain at example.com. This domain is private to the test environment.
DOMAIN=example.com
HOSTNAMES=mail.company.example.test
POSTMASTER=postmaster
TLS_FLAVOR=mail
TLS_CERT_FILENAME=fullchain.pem
TLS_KEYPAIR_FILENAME=privkey.pem

DISABLE_STATISTICS=True

ADMIN=true
WEBMAIL=roundcube
API=true
WEBDAV=none
ANTIVIRUS=none

MESSAGE_SIZE_LIMIT=50000000
RELAYNETS=
RELAYHOST=
FETCHMAIL_ENABLED=False
RECIPIENT_DELIMITER=+
DMARC_RUA=postmaster
DMARC_RUF=postmaster
WELCOME=false
COMPRESSION=
COMPRESSION_LEVEL=6
FULL_TEXT_SEARCH=off

WEBROOT_REDIRECT=/webmail
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
WEB_API=/api
SITENAME=TheAgentCompany Mail
WEBSITE=

CREDENTIAL_ROUNDS=12
REAL_IP_HEADER=
REAL_IP_FROM=
REJECT_UNLISTED_RECIPIENT=yes
LOG_LEVEL=INFO
TZ=Etc/UTC
DEFAULT_SPAM_THRESHOLD=80
API_TOKEN=REPLACE_WITH_PRIVATE_API_TOKEN
# Keep blank on 2024.06.58: that release treats the literal "False" as enabled
# in one Jinja template. Empty means attachment extraction is disabled.
FULL_TEXT_SEARCH_ATTACHMENTS=

# Bind the Caddy reverse proxy to the private Mailu HTTP port. Mail protocols are
# published separately in docker-compose.yml on the Mini's LAN address.
PORTS=25,80,443,465,587,993
